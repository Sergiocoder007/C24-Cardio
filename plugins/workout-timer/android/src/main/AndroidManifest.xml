<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background workout timer: a user-started workout keeps playing its
         timer sounds and shows a lock-screen notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name=".WorkoutTimerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Shares challenge card images; read access is granted per share. -->
        <provider
            android:name=".C24ShareProvider"
            android:authorities="${applicationId}.c24share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/c24_share_paths" />
        </provider>
    </application>
</manifest>
